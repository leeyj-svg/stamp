generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  TEMPORARY
  ACTIVE
}

enum Role {
  USER
  MEMBER
  ADMIN
}

enum LedgerEntryType {
  INCOME
  EXPENSE
  SAVING
}

enum LedgerPaymentMethod {
  CASH
  CARD
  ACCOUNT_TRANSFER
}

enum LedgerPeriodBasis {
  CALENDAR
  PAYDAY
}

enum LedgerWeekStartDay {
  SUNDAY
  MONDAY
}

enum LedgerBudgetStatus {
  OPEN
  CLOSED
}

enum LedgerWeekCarryMode {
  NONE
  AUTO
  MANUAL
}

model User {
  id          String     @id @default(cuid())
  name        String
  phoneNumber String     @unique
  status      UserStatus @default(TEMPORARY)
  role        Role?      @default(USER)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  agreedToTerms         Boolean @default(false)
  agreedToPrivacyPolicy Boolean @default(false)
  agreedToMarketing     Boolean @default(false)

  sessions                   Session[]
  keys                       Key[]
  eventEntries               StampEntry[]
  StampCard                  StampCard[]
  reviews                    Review[]
  ClaimableStampRedemption   ClaimableStampRedemption[]
  memorySpaces               MemorySpace[]
  memoryPosts                MemoryPost[]
  eventLikes                 EventLike[]
  categoryManagerAssignments EventCategoryManager[]
  uploadedAlbumPhotos        AlbumPhoto[]
  communityPosts             CommunityPost[]
  communityPostLikes         CommunityPostLike[]
  ledgerSettings             LedgerSettings?
  ledgerCategories           LedgerCategory[]
  ledgerBudgets              LedgerBudget[]
  ledgerBudgetPeriods        LedgerBudgetPeriod[]
  ledgerEntries              LedgerEntry[]
  ledgerTags                 LedgerTag[]
}

model LedgerSettings {
  id                 Int               @id @default(autoincrement())
  userId             String            @unique
  defaultPeriodBasis LedgerPeriodBasis @default(CALENDAR)
  paydayDay          Int?
  weekStartDay       LedgerWeekStartDay @default(MONDAY)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LedgerCategory {
  id        Int             @id @default(autoincrement())
  userId    String
  type      LedgerEntryType
  name      String
  color     String?
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgets LedgerBudget[]
  budgetAllocations LedgerBudgetCategoryAllocation[]
  entries LedgerEntry[]

  @@unique([userId, type, name])
  @@index([userId, type, sortOrder])
}

model LedgerBudget {
  id          Int               @id @default(autoincrement())
  userId      String
  categoryId  Int
  periodBasis LedgerPeriodBasis @default(CALENDAR)
  amount      Decimal           @db.Decimal(12, 2)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category LedgerCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, periodBasis])
  @@index([userId, periodBasis])
}

model LedgerBudgetPeriod {
  id            Int                @id @default(autoincrement())
  userId        String
  basis         LedgerPeriodBasis
  status        LedgerBudgetStatus @default(OPEN)
  periodStartAt DateTime
  periodEndAt   DateTime
  label         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plans  LedgerBudgetPlan[]
  entries LedgerEntry[]

  @@unique([userId, basis, periodStartAt, periodEndAt])
  @@index([userId, basis, status, periodStartAt])
}

model LedgerBudgetPlan {
  id            Int                 @id @default(autoincrement())
  periodId      Int
  type          LedgerEntryType
  totalAmount   Decimal             @db.Decimal(12, 2)
  weekCarryMode LedgerWeekCarryMode @default(NONE)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  period      LedgerBudgetPeriod               @relation(fields: [periodId], references: [id], onDelete: Cascade)
  allocations LedgerBudgetCategoryAllocation[]
  weeks       LedgerBudgetWeekPlan[]

  @@unique([periodId, type])
  @@index([type])
}

model LedgerBudgetCategoryAllocation {
  id            Int      @id @default(autoincrement())
  planId        Int
  categoryId    Int
  plannedAmount Decimal  @db.Decimal(12, 2)
  isFixed       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  plan     LedgerBudgetPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  category LedgerCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([planId, categoryId])
  @@index([categoryId])
}

model LedgerBudgetWeekPlan {
  id            Int                @id @default(autoincrement())
  planId        Int
  weekIndex     Int
  status        LedgerBudgetStatus @default(OPEN)
  weekStartAt   DateTime
  weekEndAt     DateTime
  plannedAmount Decimal            @db.Decimal(12, 2)
  carryInAmount Decimal            @default(0) @db.Decimal(12, 2)
  carryOutAmount Decimal           @default(0) @db.Decimal(12, 2)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  plan LedgerBudgetPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, weekIndex])
  @@index([planId, status, weekStartAt])
}

model LedgerEntry {
  id                Int                  @id @default(autoincrement())
  userId            String
  categoryId        Int?
  budgetPeriodId    Int?
  type              LedgerEntryType
  amount            Decimal              @db.Decimal(12, 2)
  paymentMethod     LedgerPaymentMethod?
  paymentSourceName String?
  memo              String?              @db.Text
  excludeFromStats  Boolean              @default(false)
  usedAt            DateTime
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     LedgerCategory?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  budgetPeriod LedgerBudgetPeriod? @relation(fields: [budgetPeriodId], references: [id], onDelete: SetNull)
  tags         LedgerEntryTag[]

  @@index([userId, usedAt])
  @@index([userId, type, usedAt])
  @@index([userId, paymentMethod, usedAt])
  @@index([userId, excludeFromStats, usedAt])
  @@index([budgetPeriodId, usedAt])
  @@index([categoryId, usedAt])
}

model LedgerTag {
  id        Int      @id @default(autoincrement())
  userId    String
  name      String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries LedgerEntryTag[]

  @@unique([userId, name])
  @@index([userId, name])
}

model LedgerEntryTag {
  entryId Int
  tagId   Int

  entry LedgerEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tag   LedgerTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([entryId, tagId])
  @@index([tagId])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(references: [id], fields: [userId], onDelete: Cascade)
}

model Key {
  id             String  @id
  userId         String
  hashedPassword String?
  user           User    @relation(references: [id], fields: [userId], onDelete: Cascade)

  @@unique([id, userId])
}

// --- 이벤트 및 스탬프 관련 모델 ---

model EventCategory {
  id       Int                    @id @default(autoincrement())
  name     String                 @unique
  events   Event[]
  managers EventCategoryManager[]
}

model Event {
  id              String           @id @default(cuid())
  name            String
  description     String?
  imageUrl        String?
  isAllDay        Boolean          @default(true)
  startDate       DateTime
  endDate         DateTime
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  categoryId      Int
  category        EventCategory    @relation(fields: [categoryId], references: [id])
  participants    StampEntry[]
  claimableStamps ClaimableStamp[] // 이 이벤트에 연결된 임시 코드 스탬프들

  images EventImage[]

  reviews Review[]
  likes   EventLike[]
}

model EventLike {
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
}

model EventCategoryManager {
  id         Int      @id @default(autoincrement())
  userId     String
  categoryId Int
  createdAt  DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category EventCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@index([categoryId])
}

model EventImage {
  id      Int    @id @default(autoincrement())
  url     String // 이미지 파일의 URL
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model StampEntry {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id])
  adminNote String?

  stampCardId Int
  stampCard   StampCard @relation(fields: [stampCardId], references: [id])
  isViewed    Boolean   @default(false)
}

model StampCard {
  id         Int          @id @default(autoincrement())
  createdAt  DateTime     @default(now())
  isRedeemed Boolean      @default(false)
  entries    StampEntry[]
  coupon     Coupon?

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

// --- 리워드 및 임시 코드 관련 모델 ---

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  description String
  isUsed      Boolean   @default(false)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  stampCardId Int       @unique
  stampCard   StampCard @relation(fields: [stampCardId], references: [id])
}

// 👈 전화번호 모를 때를 위한 '주인 없는 스탬프' 모델
model ClaimableStamp {
  id          String   @id @default(cuid())
  claimCode   String   @unique
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id])
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  // 👇 확장성을 위해 이 필드들을 추가합니다.
  maxUses     Int?     @default(1) // 최대 사용 횟수 (null: 무제한, 1: 1회용)
  currentUses Int      @default(0) // 현재 사용 횟수

  // 👇 사용 기록을 위한 관계를 추가합니다.
  redemptions ClaimableStampRedemption[]
}

// 👇 이 모델을 파일 하단에 새로 추가해주세요.
model ClaimableStampRedemption {
  id         Int      @id @default(autoincrement())
  redeemedAt DateTime @default(now())

  claimableStampId String
  claimableStamp   ClaimableStamp @relation(fields: [claimableStampId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // 한 사용자는 같은 코드를 한 번만 사용할 수 있습니다.
  @@unique([claimableStampId, userId])
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int // 별점 (1~5)
  comment   String?  @db.Text // 리뷰 내용 (최대 글자 수를 늘리기 위해 @db.Text 사용)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- 관계 설정 ---
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- 규칙 설정 ---
  // 한 명의 유저는 하나의 이벤트에 대해 리뷰를 한 번만 작성할 수 있습니다.
  @@unique([userId, eventId])
}

model GameSession {
  id         Int     @id @default(autoincrement())
  isRevealed Boolean @default(false) // 정답 공개 여부
  gameState  Json // 모든 팀의 상태와 제출 글자를 유연하게 담습니다.
}

// --- 생일 롤링페이퍼 & 앨범(Memory) 관련 모델 ---

model MemorySpace {
  id         String   @id @default(uuid())
  title      String // "000 생일 축하해"
  targetDate DateTime // 12월 25일 (이 날짜 전엔 못 들어감)
  password   String // "0000" (생일자 접속용 비번)

  // AI가 분석한 '별자리 배치 정보'를 저장하는 JSON (전체 맵)
  starMap Json? // { "posts": [{id:1, x:10, y:20}, ...] }

  posts     MemoryPost[]
  createdAt DateTime     @default(now())
  user      User?        @relation(fields: [userId], references: [id])
  userId    String?
}

model MemoryPost {
  id      Int         @id @default(autoincrement())
  spaceId String
  space   MemorySpace @relation(fields: [spaceId], references: [id])

  type     String // "MESSAGE" (롤링페이퍼) | "PHOTO" (앨범)
  content  String? // 내용
  mediaUrl String? // 사진 URL

  // 작성자 정보
  writerId String? // 로그인한 유저 ID (비회원이면 null)
  writer   User?   @relation(fields: [writerId], references: [id])

  //
  nickname String // "지나가던 친구" (필수)

  // 개별 스타일 (AI가 분석한 감정, 색상 등)
  aiStyle   Json?
  password  String?
  createdAt DateTime @default(now())
}

model PhotoAlbum {
  id            Int          @id @default(autoincrement())
  name          String       @unique
  slug          String       @unique
  immichAlbumId String?      @unique
  description   String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  photos        AlbumPhoto[]
}

model AlbumPhoto {
  id               Int        @id @default(autoincrement())
  albumId          Int
  album            PhotoAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  imageUrl         String
  immichAssetId    String?
  caption          String?
  uploadedByUserId String?
  uploadedByUser   User?      @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  uploaderName     String?
  takenAt          DateTime?
  createdAt        DateTime   @default(now())

  @@index([albumId, createdAt])
  @@index([immichAssetId])
}

model CommunityPost {
  id        Int                 @id @default(autoincrement())
  title     String
  content   String              @db.Text
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     CommunityPostLike[]

  @@index([createdAt])
}

model CommunityPostLike {
  postId    Int
  userId    String
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}
