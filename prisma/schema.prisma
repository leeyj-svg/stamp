generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  TEMPORARY
  ACTIVE
}

enum Role {
  USER
  MEMBER
  ADMIN
}

enum LedgerEntryType {
  INCOME
  EXPENSE
  SAVING
}

enum LedgerPaymentMethod {
  CASH
  CARD
  ACCOUNT_TRANSFER
}

enum LedgerPeriodBasis {
  CALENDAR
  PAYDAY
}

enum LedgerWeekStartDay {
  SUNDAY
  MONDAY
}

enum LedgerBudgetStatus {
  OPEN
  CLOSED
}

enum LedgerWeekCarryMode {
  NONE
  AUTO
  MANUAL
}

enum LedgerPlannedPurchaseStatus {
  PLANNED
  HOLD
  PURCHASED
  CANCELED
}

enum RoutineRecordStatus {
  SUCCESS
  FAIL
  SKIPPED
}

enum DevWorkAttachmentKind {
  IMAGE
  DOCUMENT
  ARCHIVE
  OTHER
}

enum SpaceViewport {
  DESKTOP
  MOBILE
}

enum SpaceSurface {
  MEMORY
  ALBUM
}

model User {
  id          String     @id @default(cuid())
  name        String
  phoneNumber String     @unique
  status      UserStatus @default(TEMPORARY)
  role        Role?      @default(USER)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  agreedToTerms         Boolean @default(false)
  agreedToPrivacyPolicy Boolean @default(false)
  agreedToMarketing     Boolean @default(false)

  sessions                   Session[]
  keys                       Key[]
  eventEntries               StampEntry[]
  StampCard                  StampCard[]
  reviews                    Review[]
  ClaimableStampRedemption   ClaimableStampRedemption[]
  memorySpaces               MemorySpace[]
  memoryPosts                MemoryPost[]
  eventLikes                 EventLike[]
  categoryManagerAssignments EventCategoryManager[]
  uploadedAlbumPhotos        AlbumPhoto[]
  communityPosts             CommunityPost[]
  communityPostLikes         CommunityPostLike[]
  ledgerSettings             LedgerSettings?
  ledgerCategories           LedgerCategory[]
  ledgerBudgets              LedgerBudget[]
  ledgerBudgetPeriods        LedgerBudgetPeriod[]
  ledgerEntries              LedgerEntry[]
  ledgerTags                 LedgerTag[]
  ledgerPlannedPurchases     LedgerPlannedPurchase[]
  routineTypes               RoutineType[]
  routineRecords             RoutineRecord[]
  routineDayNotes            RoutineDayNote[]
  devWorkSets                DevWorkSet[]
  devWorkStatuses            DevWorkStatusDefinition[]
  devDiaryPages              DevDiaryPage[]
  devWorkItems               DevWorkItem[]
}

model LedgerSettings {
  id                 Int                @id @default(autoincrement())
  userId             String             @unique
  defaultPeriodBasis LedgerPeriodBasis  @default(CALENDAR)
  paydayDay          Int?
  weekStartDay       LedgerWeekStartDay @default(MONDAY)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LedgerCategory {
  id        Int             @id @default(autoincrement())
  userId    String
  type      LedgerEntryType
  name      String
  color     String?
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user              User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgets           LedgerBudget[]
  budgetAllocations LedgerBudgetCategoryAllocation[]
  entries           LedgerEntry[]
  plannedPurchases  LedgerPlannedPurchase[]

  @@unique([userId, type, name])
  @@index([userId, type, sortOrder])
}

model LedgerBudget {
  id          Int               @id @default(autoincrement())
  userId      String
  categoryId  Int
  periodBasis LedgerPeriodBasis @default(CALENDAR)
  amount      Decimal           @db.Decimal(12, 2)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category LedgerCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, periodBasis])
  @@index([userId, periodBasis])
}

model LedgerBudgetPeriod {
  id            Int                @id @default(autoincrement())
  userId        String
  basis         LedgerPeriodBasis
  status        LedgerBudgetStatus @default(OPEN)
  periodStartAt DateTime
  periodEndAt   DateTime
  label         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plans   LedgerBudgetPlan[]
  entries LedgerEntry[]

  @@unique([userId, basis, periodStartAt, periodEndAt])
  @@index([userId, basis, status, periodStartAt])
}

model LedgerBudgetPlan {
  id            Int                 @id @default(autoincrement())
  periodId      Int
  type          LedgerEntryType
  totalAmount   Decimal             @db.Decimal(12, 2)
  weekCarryMode LedgerWeekCarryMode @default(NONE)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  period      LedgerBudgetPeriod               @relation(fields: [periodId], references: [id], onDelete: Cascade)
  allocations LedgerBudgetCategoryAllocation[]
  weeks       LedgerBudgetWeekPlan[]

  @@unique([periodId, type])
  @@index([type])
}

model LedgerBudgetCategoryAllocation {
  id            Int      @id @default(autoincrement())
  planId        Int
  categoryId    Int
  plannedAmount Decimal  @db.Decimal(12, 2)
  isFixed       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  plan     LedgerBudgetPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  category LedgerCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([planId, categoryId])
  @@index([categoryId])
}

model LedgerBudgetWeekPlan {
  id             Int                @id @default(autoincrement())
  planId         Int
  weekIndex      Int
  status         LedgerBudgetStatus @default(OPEN)
  weekStartAt    DateTime
  weekEndAt      DateTime
  plannedAmount  Decimal            @db.Decimal(12, 2)
  carryInAmount  Decimal            @default(0) @db.Decimal(12, 2)
  carryOutAmount Decimal            @default(0) @db.Decimal(12, 2)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  plan LedgerBudgetPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, weekIndex])
  @@index([planId, status, weekStartAt])
}

model LedgerEntry {
  id                Int                  @id @default(autoincrement())
  userId            String
  categoryId        Int?
  budgetPeriodId    Int?
  type              LedgerEntryType
  amount            Decimal              @db.Decimal(12, 2)
  paymentMethod     LedgerPaymentMethod?
  paymentSourceName String?
  memo              String?              @db.Text
  excludeFromStats  Boolean              @default(false)
  usedAt            DateTime
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     LedgerCategory?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  budgetPeriod LedgerBudgetPeriod? @relation(fields: [budgetPeriodId], references: [id], onDelete: SetNull)
  tags         LedgerEntryTag[]

  @@index([userId, usedAt])
  @@index([userId, type, usedAt])
  @@index([userId, paymentMethod, usedAt])
  @@index([userId, excludeFromStats, usedAt])
  @@index([budgetPeriodId, usedAt])
  @@index([categoryId, usedAt])
}

model LedgerTag {
  id        Int      @id @default(autoincrement())
  userId    String
  name      String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries LedgerEntryTag[]

  @@unique([userId, name])
  @@index([userId, name])
}

model LedgerEntryTag {
  entryId Int
  tagId   Int

  entry LedgerEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tag   LedgerTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([entryId, tagId])
  @@index([tagId])
}

model LedgerPlannedPurchase {
  id         Int                       @id @default(autoincrement())
  userId     String
  categoryId Int?
  title      String
  amount     Decimal                   @db.Decimal(12, 2)
  memo       String?                   @db.Text
  plannedFor DateTime
  status     LedgerPlannedPurchaseStatus @default(PLANNED)
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category LedgerCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, plannedFor])
  @@index([userId, status, plannedFor])
  @@index([categoryId, plannedFor])
}

model RoutineType {
  id              Int      @id @default(autoincrement())
  userId          String
  name            String
  color           String?
  weeklyGoalCount Int?
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  records RoutineRecord[]

  @@unique([userId, name])
  @@index([userId, sortOrder, isActive])
}

model RoutineRecord {
  id          Int                 @id @default(autoincrement())
  userId      String
  typeId      Int
  status      RoutineRecordStatus @default(SUCCESS)
  recordDate  DateTime
  performedAt DateTime?
  photoUrl1   String?
  photoUrl2   String?
  memo        String?             @db.Text
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type RoutineType @relation(fields: [typeId], references: [id], onDelete: Cascade)

  @@index([userId, recordDate])
  @@index([userId, status, recordDate])
  @@index([userId, typeId, recordDate])
  @@index([typeId, recordDate])
}

model RoutineDayNote {
  id         Int      @id @default(autoincrement())
  userId     String
  recordDate DateTime
  memo       String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, recordDate])
  @@index([userId, recordDate])
}

model DevWorkSet {
  id        Int      @id @default(autoincrement())
  userId    String
  name      String
  icon      String   @default("briefcase")
  color     String   @default("#b7844d")
  githubIssueRepoOwner String? @db.VarChar(191)
  githubIssueRepoName String?  @db.VarChar(191)
  githubIssueLabels String?    @db.VarChar(512)
  githubIssueTokenEncrypted String? @db.Text
  sortOrder Int      @default(0)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  diaryPages DevDiaryPage[]
  workItems  DevWorkItem[]

  @@index([userId, sortOrder])
  @@index([userId, isDefault])
}

model DevDiaryPage {
  id        Int      @id @default(autoincrement())
  userId    String
  workSetId Int
  pageDate  DateTime
  title     String?
  noteMd    String?  @db.Text
  statusTitlesJson Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  workSet   DevWorkSet          @relation(fields: [workSetId], references: [id], onDelete: Cascade)
  workItems DevDiaryPageEntry[]

  @@unique([userId, workSetId, pageDate])
  @@index([userId, workSetId, pageDate])
}

model DevWorkStatusDefinition {
  id        Int      @id @default(autoincrement())
  userId    String
  statusKey String   @db.VarChar(64)
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, statusKey])
  @@index([userId, sortOrder])
}

model DevWorkItem {
  id           Int           @id @default(autoincrement())
  userId       String
  workSetId    Int
  parentWorkItemId Int?
  title        String
  status       String        @default("TODO") @db.VarChar(64)
  contentMd    String?       @db.Text
  nextAction   String?       @db.Text
  githubIssueRepo String?    @db.VarChar(191)
  githubIssueNumber Int?
  githubIssueUrl  String?    @db.VarChar(512)
  priority     Int           @default(0)
  sortOrder    Int           @default(0)
  isMinimized  Boolean       @default(false)
  isPinned     Boolean       @default(false)
  boardX       Int           @default(48)
  boardY       Int           @default(48)
  plannedDate  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  lastWorkedAt DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workSet         DevWorkSet             @relation(fields: [workSetId], references: [id], onDelete: Cascade)
  parentWorkItem  DevWorkItem?           @relation("DevWorkItemHierarchy", fields: [parentWorkItemId], references: [id], onDelete: SetNull)
  childWorkItems  DevWorkItem[]          @relation("DevWorkItemHierarchy")
  diaryPages      DevDiaryPageEntry[]
  notes           DevWorkNote[]
  checklist       DevWorkChecklistItem[]
  attachments     DevWorkAttachment[]
  @@index([userId, workSetId, status, updatedAt])
  @@index([userId, workSetId, parentWorkItemId, updatedAt])
  @@index([userId, workSetId, plannedDate])
  @@index([userId, workSetId, isMinimized, updatedAt])
  @@index([userId, workSetId, isPinned, updatedAt])
  @@index([githubIssueRepo, githubIssueNumber])
}

model DevWorkNote {
  id         Int      @id @default(autoincrement())
  workItemId Int
  contentMd  String   @db.Text
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workItem DevWorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@index([workItemId, sortOrder])
  @@index([workItemId, createdAt])
}

model DevDiaryPageEntry {
  id         Int      @id @default(autoincrement())
  pageId     Int
  workItemId Int
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  page     DevDiaryPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  workItem DevWorkItem  @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@unique([pageId, workItemId])
  @@index([pageId, sortOrder])
  @@index([workItemId, createdAt])
}

model DevWorkChecklistItem {
  id          Int       @id @default(autoincrement())
  workItemId  Int
  content     String
  isDone      Boolean   @default(false)
  isTodayTodo Boolean   @default(false)
  sortOrder   Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workItem DevWorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@index([workItemId, sortOrder])
  @@index([workItemId, isDone, sortOrder])
  @@index([workItemId, isTodayTodo, isDone])
}

model DevWorkAttachment {
  id         Int                   @id @default(autoincrement())
  workItemId Int
  kind       DevWorkAttachmentKind @default(OTHER)
  fileName   String
  url        String
  mimeType   String?
  byteSize   Int?
  sortOrder  Int                   @default(0)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  workItem DevWorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@index([workItemId, sortOrder])
  @@index([workItemId, kind, createdAt])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(references: [id], fields: [userId], onDelete: Cascade)
}

model Key {
  id             String  @id
  userId         String
  hashedPassword String?
  user           User    @relation(references: [id], fields: [userId], onDelete: Cascade)

  @@unique([id, userId])
}

// --- 이벤트 및 스탬프 관련 모델 ---

model EventCategory {
  id       Int                    @id @default(autoincrement())
  name     String                 @unique
  events   Event[]
  managers EventCategoryManager[]
}

model Event {
  id              String           @id @default(cuid())
  name            String
  description     String?
  imageUrl        String?
  isAllDay        Boolean          @default(true)
  startDate       DateTime
  endDate         DateTime
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  categoryId      Int
  category        EventCategory    @relation(fields: [categoryId], references: [id])
  participants    StampEntry[]
  claimableStamps ClaimableStamp[] // 이 이벤트에 연결된 임시 코드 스탬프들

  images EventImage[]

  reviews Review[]
  likes   EventLike[]
}

model EventLike {
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
}

model EventCategoryManager {
  id         Int      @id @default(autoincrement())
  userId     String
  categoryId Int
  createdAt  DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category EventCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@index([categoryId])
}

model EventImage {
  id      Int    @id @default(autoincrement())
  url     String // 이미지 파일의 URL
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model StampEntry {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id])
  adminNote String?

  stampCardId Int
  stampCard   StampCard @relation(fields: [stampCardId], references: [id])
  isViewed    Boolean   @default(false)
}

model StampCard {
  id         Int          @id @default(autoincrement())
  createdAt  DateTime     @default(now())
  isRedeemed Boolean      @default(false)
  entries    StampEntry[]
  coupon     Coupon?

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

// --- 리워드 및 임시 코드 관련 모델 ---

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  description String
  isUsed      Boolean   @default(false)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  stampCardId Int       @unique
  stampCard   StampCard @relation(fields: [stampCardId], references: [id])
}

// 👈 전화번호 모를 때를 위한 '주인 없는 스탬프' 모델
model ClaimableStamp {
  id          String   @id @default(cuid())
  claimCode   String   @unique
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id])
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  // 👇 확장성을 위해 이 필드들을 추가합니다.
  maxUses     Int?     @default(1) // 최대 사용 횟수 (null: 무제한, 1: 1회용)
  currentUses Int      @default(0) // 현재 사용 횟수

  // 👇 사용 기록을 위한 관계를 추가합니다.
  redemptions ClaimableStampRedemption[]
}

// 👇 이 모델을 파일 하단에 새로 추가해주세요.
model ClaimableStampRedemption {
  id         Int      @id @default(autoincrement())
  redeemedAt DateTime @default(now())

  claimableStampId String
  claimableStamp   ClaimableStamp @relation(fields: [claimableStampId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // 한 사용자는 같은 코드를 한 번만 사용할 수 있습니다.
  @@unique([claimableStampId, userId])
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int // 별점 (1~5)
  comment   String?  @db.Text // 리뷰 내용 (최대 글자 수를 늘리기 위해 @db.Text 사용)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- 관계 설정 ---
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- 규칙 설정 ---
  // 한 명의 유저는 하나의 이벤트에 대해 리뷰를 한 번만 작성할 수 있습니다.
  @@unique([userId, eventId])
}

model GameSession {
  id         Int     @id @default(autoincrement())
  isRevealed Boolean @default(false) // 정답 공개 여부
  gameState  Json // 모든 팀의 상태와 제출 글자를 유연하게 담습니다.
}

// --- 단어게임 (단계별 단어 공개 + Go/Stop/Fail) ---

model WordGameTopic {
  id        Int      @id @default(autoincrement())
  title     String // 주제
  stages    Json // string[][] 길이 5, 각 단계 후보 단어 배열
  createdAt DateTime @default(now())
}

model WordGameSession {
  id        Int  @id @default(autoincrement())
  gameState Json // 라운드/점수 상태
}

// --- 팀 점수판 (여러 게임 공용 점수 도구) ---

model Scoreboard {
  id         Int     @id @default(autoincrement())
  mode       String  @default("teams") // "teams" | "hostVsTeams"
  amount1    Int     @default(50) // 카드 가감 버튼 값 1
  amount2    Int     @default(100) // 카드 가감 버튼 값 2
  teamBonus  Int     @default(0) // 팀 공통 추가점수 (팀합산 = 개별 합 + teamBonus)
  theme      String  @default("slate") // 배경 테마 키
  cardColor  String  @default("") // 카드색 직접 지정(hex). 빈 값이면 배경에서 자동 파생
  soundOn    Boolean @default(true)
  hostName   String  @default("사회자")
  hostScore  Int     @default(0)
  hostHidden Boolean @default(true) // 큰 화면에서 사회자 점수 숨김

  teams ScoreTeam[]
}

model ScoreTeam {
  id      Int   @id @default(autoincrement())
  name    String
  score   Int   @default(0)
  x       Float @default(10) // 배치 x (보드 폭 대비 %)
  y       Float @default(10) // 배치 y (보드 높이 대비 %)
  w       Int   @default(320) // 카드 폭(px)
  h       Int   @default(200) // 카드 높이(px)
  order   Int   @default(0) // 리스트/폰 표시 순서

  boardId Int
  board   Scoreboard @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId])
}

// --- 생일 롤링페이퍼 & 앨범(Memory) 관련 모델 ---

model MemorySpace {
  id         String   @id @default(uuid())
  title      String // "000 생일 축하해"
  targetDate DateTime // 12월 25일 (이 날짜 전엔 못 들어감)
  password   String // "0000" (생일자 접속용 비번)
  themeKey   String   @default("galaxy")

  // AI가 분석한 '별자리 배치 정보'를 저장하는 JSON (전체 맵)
  starMap Json? // { "posts": [{id:1, x:10, y:20}, ...] }

  posts       MemoryPost[]
  appearances MemorySpaceAppearance[]
  createdAt   DateTime                @default(now())
  user        User?                   @relation(fields: [userId], references: [id])
  userId      String?
}

model MemoryPost {
  id      Int         @id @default(autoincrement())
  spaceId String
  space   MemorySpace @relation(fields: [spaceId], references: [id])

  type     String // "MESSAGE" (롤링페이퍼) | "PHOTO" (앨범)
  content  String? @db.Text // 내용
  mediaUrl String? // 크게 보기용 사진 URL
  thumbnailUrl String? // 카드/목록용 썸네일 URL

  // 작성자 정보
  writerId String? // 로그인한 유저 ID (비회원이면 null)
  writer   User?   @relation(fields: [writerId], references: [id])

  //
  nickname String // "지나가던 친구" (필수)

  // 개별 스타일 (AI가 분석한 감정, 색상 등)
  aiStyle     Json?
  password    String?
  appearances MemoryPostAppearance[]
  createdAt   DateTime               @default(now())

  @@index([spaceId, type, createdAt])
}

model MemorySpaceAppearance {
  id        Int           @id @default(autoincrement())
  spaceId   String
  viewport  SpaceViewport
  surface   SpaceSurface
  layoutKey String
  config    Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  space MemorySpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, viewport, surface])
  @@index([spaceId, viewport])
}

model MemoryPostAppearance {
  id        Int           @id @default(autoincrement())
  postId    Int
  viewport  SpaceViewport
  surface   SpaceSurface
  style     Json?
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  post MemoryPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, viewport, surface])
  @@index([viewport, surface, sortOrder])
}

model PhotoAlbum {
  id            Int          @id @default(autoincrement())
  name          String       @unique
  slug          String       @unique
  immichAlbumId String?      @unique
  description   String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  photos        AlbumPhoto[]
}

model AlbumPhoto {
  id               Int        @id @default(autoincrement())
  albumId          Int
  album            PhotoAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  imageUrl         String
  immichAssetId    String?
  caption          String?
  uploadedByUserId String?
  uploadedByUser   User?      @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  uploaderName     String?
  takenAt          DateTime?
  createdAt        DateTime   @default(now())

  @@index([albumId, createdAt])
  @@index([immichAssetId])
}

model CommunityPost {
  id        Int                 @id @default(autoincrement())
  title     String
  content   String              @db.Text
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     CommunityPostLike[]

  @@index([createdAt])
}

model CommunityPostLike {
  postId    Int
  userId    String
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}
